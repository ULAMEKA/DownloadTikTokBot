# Telegram bot token from @BotFather.
TOKEN=your_telegram_bot_token

# Optional: used to build deep-links in video captions. If omitted, the bot
# resolves its public username with getMe when it first sends a video.
BOT_USERNAME=

# Optional for regular messages; required for uncached inline delivery.
# Use the negative numeric ID of a channel where the bot is an administrator.
STORAGE_CHAT_ID=

# Optional directory with Netscape cookie files named by service/domain:
# tiktok.cookies.txt, instagram.cookies.txt, youtube.cookies.txt, etc.
# Multiple accounts are discovered as tiktok.*.cookies.txt,
# tiktok-*.cookies.txt, or tiktok/*.cookies.txt and tried in sorted order.
MEDIA_COOKIES_DIR=

# Optional JSON overrides for custom domains or filenames. Relative paths are
# resolved inside MEDIA_COOKIES_DIR.
# MEDIA_COOKIE_MAP={"tiktok.com":["tiktok-main.cookies.txt","tiktok-backup.cookies.txt"],"*.instagram.com":"instagram.cookies.txt"}
