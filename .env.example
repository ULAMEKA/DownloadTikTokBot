# ВНИМАНИЕ: для скачивания нужен ffmpeg в PATH (это системная утилита, не pip-пакет).
# Linux: apt install ffmpeg | Windows: winget install Gyan.FFmpeg

# Токен Telegram-бота (обязательно)
TOKEN=your_telegram_bot_token

# ID канала-хранилища для кеширования file_id (опционально).
# Отрицательное число для каналов, например -1001234567890.
STORAGE_CHAT_ID=

# Подключение к БД (опционально, по умолчанию локальный SQLite).
DB_URL=sqlite+aiosqlite:///./DownloadTT.db

# Логировать каждый SQL-запрос (опционально, по умолчанию выключено).
DB_ECHO=false
